# ==========================================
# LOBO AI SALES AGENT - ENVIRONMENT CONFIG EXAMPLE
# ==========================================

PROJECT_NAME="Lobo AI Sales Agent"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"
LOG_LEVEL=INFO

# --- CORE LLM PROVIDERS ---
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash

OPENAI_API_KEY=your_openai_api_key_here

TYPESAFE_API_KEY=your_typesafe_key_here
JEV_ENABLED=false

# --- DATABASE & CACHE ---
REDIS_URL="redis://localhost:6379/0"
# auto = tenta REDIS_URL e cai para fakeredis em memória fora de produção
# redis = exige Redis real (use na VPS/Easypanel) | fake = sempre em memória
REDIS_BACKEND=auto
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lobo_sales_agent"

# --- WHATSAPP GATEWAYS ---
WAHA_BASE_URL="https://waha.yourdomain.com"
WAHA_API_KEY="your_waha_api_key"
WAHA_SESSION="default"
# Opcional: mesma chave configurada em webhooks[].hmac.key no WAHA (valida X-Webhook-Hmac)
WAHA_WEBHOOK_HMAC_KEY=""

ASTRACALLS_BASE_URL="https://chamadas.yourdomain.com"
ASTRACALLS_SESSION_ID=""
ASTRACALLS_CLIENT_ID=""
ASTRACALLS_API_KEY=""
# Opcional: "secret" do webhook da sessão no AstraCalls (valida X-Webhook-Signature)
ASTRACALLS_WEBHOOK_SECRET=""

# --- CRM & PLATFORM CONNECTORS ---
CHATWOOT_BASE_URL="https://chatwoot.yourdomain.com"
CHATWOOT_API_TOKEN="your_token"

GHL_VIZZU_API_TOKEN=""
GHL_VIZZU_LOCATION_ID=""

# --- DEBOUNCE SETTINGS ---
DEBOUNCE_SILENCE_SECONDS=4
DEBOUNCE_MAX_WINDOW_SECONDS=10

# --- TENANTS & HANDOFF ---
# Diretório com data/tenants/<tenant_id>.json (padrão: ./data/tenants)
# TENANT_DATA_DIR=./data/tenants
# Horas que a IA fica silenciada para o contato após um handoff humano
AI_PAUSE_HOURS=24

# --- TRAVA DE SEGURANÇA (SANDBOX) ---
# Fora de produção a trava é SEMPRE aplicada: a IA só responde números liberados,
# sessões de teste (/lobo ou /lobo-sales-agent, 30 min) e reseta com /parar ou /reset.
# Números sempre liberados (somados à whitelist do painel), separados por vírgula:
SANDBOX_ALLOWED_PHONES=""
# Arquivo onde o painel persiste a config do Sandbox (padrão: ./data/sandbox_config.json)
# SANDBOX_CONFIG_PATH=./data/sandbox_config.json

# --- PAINEL ADMINISTRATIVO (GET /) ---
# Se definido, /api/admin/* exige o header X-Admin-Token. OBRIGATÓRIO em produção.
ADMIN_TOKEN=""
